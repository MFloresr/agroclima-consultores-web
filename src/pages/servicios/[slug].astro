---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({ params: { slug: servicio.id }, props: { servicio } }));
}

interface Props {
  servicio: CollectionEntry<'servicios'>;
}

const { servicio } = Astro.props;
const { Content } = await render(servicio);
const { titulo, tituloCorto, resumen, beneficios, icono, seoDescripcion } = servicio.data;
const otros = (await getCollection('servicios'))
  .filter((s) => s.id !== servicio.id)
  .sort((a, b) => a.data.orden - b.data.orden);
const solicitar = `/contacto?servicio=${encodeURIComponent(tituloCorto)}#formulario`;
---

<Base titulo={titulo} descripcion={seoDescripcion}>
  <article class="contenedor seccion servicio">
    <nav class="migas" aria-label="Estás en"><a href="/servicios">Servicios</a> / <span>{tituloCorto}</span></nav>
    <header class="cabecera">
      <span class="icono"><Icono nombre={icono} tamano={30} grosor={1.8} /></span>
      <h1>{titulo}</h1>
      <p class="resumen">{resumen}</p>
    </header>

    <div class="cuerpo">
      <div class="texto">
        <Content />
      </div>
      <aside class="tarjeta lateral">
        <h2>Lo que ganas</h2>
        <ul>
          {
            beneficios.map((b) => (
              <li>
                <Icono nombre="check" tamano={20} grosor={2.4} />
                {b}
              </li>
            ))
          }
        </ul>
        <a class="btn btn-principal btn-grande" href={solicitar}>Pedir presupuesto</a>
        <p class="nota">Sin compromiso. Te llamamos para ver tu caso.</p>
      </aside>
    </div>
  </article>

  <section class="contenedor otros" aria-labelledby="titulo-otros">
    <h2 id="titulo-otros">Otros servicios</h2>
    <ul>
      {
        otros.map((s) => (
          <li>
            <a href={`/servicios/${s.id}`}>
              <Icono nombre={s.data.icono} tamano={22} grosor={1.8} />
              {s.data.tituloCorto}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .migas {
    font-size: 15px;
    color: var(--suave);
    margin-bottom: 20px;
  }
  .cabecera {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 820px;
    margin-bottom: 48px;
  }
  .icono {
    width: 60px;
    height: 60px;
    border-radius: 18px;
    background: var(--verde-claro);
    color: var(--verde);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  h1 {
    font-size: clamp(32px, 4.5vw, 50px);
  }
  .resumen {
    font-size: 20px;
    color: var(--tinta-2);
  }
  .cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 380px;
    gap: 56px;
    align-items: start;
  }
  .texto {
    max-width: 720px;
    font-size: 18px;
  }
  .texto :global(h2) {
    font-size: 28px;
    margin: 36px 0 14px;
  }
  .texto :global(p) {
    margin-bottom: 16px;
    color: var(--tinta-2);
  }
  .texto :global(ul) {
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: var(--tinta-2);
  }
  .lateral {
    position: sticky;
    top: 104px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .lateral h2 {
    font-size: 24px;
  }
  .lateral ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .lateral li {
    display: flex;
    gap: 10px;
  }
  .lateral li :global(svg) {
    color: var(--verde);
    flex-shrink: 0;
  }
  .nota {
    font-size: 14px;
    color: var(--suave);
  }
  .otros {
    padding-bottom: 96px;
  }
  .otros h2 {
    font-size: 28px;
    margin-bottom: 20px;
  }
  .otros ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .otros a {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 0 20px;
    border-radius: 18px;
    background: var(--blanco);
    border: 1px solid var(--linea);
    color: var(--tinta);
    text-decoration: none;
    font-weight: 600;
  }
  .otros a :global(svg) {
    color: var(--verde);
  }
  .otros a:hover {
    border-color: var(--verde);
  }
  @media (max-width: 1000px) {
    .cuerpo {
      grid-template-columns: 1fr;
    }
    .lateral {
      position: static;
    }
    .otros ul {
      grid-template-columns: 1fr;
    }
  }
</style>
