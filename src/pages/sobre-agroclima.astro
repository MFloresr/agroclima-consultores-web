---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import { obtenerSobre } from '../lib/contenido';
import { textoAHtml } from '../lib/sanity';

const sobre = await obtenerSobre();
---

<Base titulo="Sobre AgroClima" descripcion={sobre.entradilla}>
  <section class="contenedor seccion sobre">
    <div class="imagen">
      <Foto imagen={sobre.foto} descripcion="Jordi Puig revisando una estación en una finca" alto="520px" proporcion={12 / 13} prioridad />
    </div>
    <div class="texto">
      <p class="antetitulo">Sobre AgroClima</p>
      <h1>{sobre.titulo}</h1>
      <div class="cuerpo" set:html={textoAHtml(sobre.texto)} />
      {
        sobre.cifras && sobre.cifras.length > 0 && (
          <dl class="cifras">
            {sobre.cifras.map((c) => (
              <div>
                <dt>{c.etiqueta}</dt>
                <dd>{c.valor}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <a class="btn btn-principal btn-grande" href="/contacto">Hablemos de tu finca</a>
    </div>
  </section>
</Base>

<style>
  .sobre {
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }
  .imagen {
    border-radius: 28px;
    overflow: hidden;
    position: sticky;
    top: 104px;
  }
  .texto {
    display: flex;
    flex-direction: column;
    gap: 20px;
    max-width: 680px;
  }
  h1 {
    font-size: clamp(32px, 4vw, 46px);
  }
  .cuerpo {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 18px;
    color: var(--tinta-2);
  }
  .cuerpo :global(h2) {
    font-size: 26px;
    color: var(--tinta);
    margin-top: 12px;
  }
  .cifras {
    margin: 8px 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .cifras div {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
  }
  .cifras dd {
    margin: 0;
    font-family: var(--f-titulo);
    font-weight: 600;
    font-size: 34px;
    color: var(--verde);
  }
  .cifras dt {
    font-size: 15px;
    color: var(--suave);
  }
  .texto .btn {
    align-self: flex-start;
  }
  @media (max-width: 900px) {
    .sobre {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .imagen {
      position: static;
    }
  }
</style>
