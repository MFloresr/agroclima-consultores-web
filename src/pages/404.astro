---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" sinIndexar>
  <section class="contenedor seccion no-encontrada">
    <p class="antetitulo">Error 404</p>
    <h1>Esta página no existe</h1>
    <p>Puede que el enlace esté mal escrito o que la página se haya movido.</p>
    <div class="botones">
      <a class="btn btn-verde" href="/">Ir al inicio</a>
      <a class="btn btn-borde" href="/contacto">Contactar</a>
    </div>
  </section>
</Base>

<style>
  .no-encontrada {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
  }
  h1 {
    font-size: clamp(34px, 5vw, 52px);
  }
  p:not(.antetitulo) {
    font-size: 18px;
    color: var(--tinta-2);
  }
  .botones {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
</style>
