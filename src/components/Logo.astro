---
// Logo de AgroClima Consultores: una hoja (el campo) cuyo nervio es una línea de datos (el clima),
// con el sol detrás. Colores de la marca: verde oscuro y naranja.
// La versión "claro" es para fondos oscuros (pie de página).
interface Props {
  tamano?: number;
  claro?: boolean;
}
const { tamano = 42, claro = false } = Astro.props;
const hoja = claro ? '#5C9A63' : '#23462C';
---

<span class:list={['logo', { claro }]}>
  <svg width={tamano} height={tamano} viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <circle cx="13" cy="13" r="7" fill="#D9661F"></circle>
    <path d="M6 42C6 22.5 20.5 8 42 6c0 21.5-14.5 36-36 36Z" fill={hoja}></path>
    <path d="M9.5 38.5 16 30l5 3.5 6-10 5 2.5 6-12.5" stroke="#F6F1E7" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span class="texto">
    <span class="nombre"><span class="agro">Agro</span><span class="clima">Clima</span></span>{' '}
    <span class="apellido">Consultores</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    color: var(--tinta);
  }
  .texto {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }
  .nombre {
    font-family: var(--f-titulo);
    font-weight: 600;
    font-size: 23px;
    letter-spacing: -0.01em;
  }
  .agro {
    color: var(--verde-oscuro);
  }
  .clima {
    color: var(--naranja);
  }
  .apellido {
    margin-top: 3px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--suave);
  }
  .claro .agro {
    color: var(--arena);
  }
  .claro .clima {
    color: #e8913a;
  }
  .claro .apellido {
    color: #d5e0d1;
  }
</style>
