---
// Hueco para una foto real. PENDIENTE: sustituir por <Image /> con las fotos de AgroClima.
interface Props {
  descripcion: string;
  alto?: string;
  class?: string;
}
const { descripcion, alto = '100%', class: clase } = Astro.props;
---

<div class:list={['foto-pendiente', clase]} style={`min-height: ${alto}`} role="img" aria-label={descripcion}>
  <span>Foto: {descripcion}</span>
</div>

<style>
  .foto-pendiente {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
    border-radius: inherit;
    background: repeating-linear-gradient(135deg, #e2d8c6 0 14px, #eae2d3 14px 28px);
    color: #4e473a;
    font-size: 15px;
    font-weight: 600;
    height: 100%;
  }
</style>
