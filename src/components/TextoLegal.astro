---
import Base from '../layouts/Base.astro';

interface Props {
  titulo: string;
  actualizado: string;
}
const { titulo, actualizado } = Astro.props;
---

<Base titulo={titulo}>
  <article class="contenedor seccion legal">
    <h1>{titulo}</h1>
    <p class="fecha">Última actualización: {actualizado}</p>
    <p class="revision">Texto base pendiente de revisión por un asesor legal antes de la publicación definitiva.</p>
    <slot />
  </article>
</Base>

<style>
  .legal {
    max-width: 820px;
  }
  h1 {
    font-size: clamp(32px, 4vw, 44px);
    margin-bottom: 8px;
  }
  .fecha {
    color: var(--suave);
    margin-bottom: 16px;
  }
  .revision {
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--aviso-fondo);
    border: 1px solid var(--aviso-borde);
    margin-bottom: 32px;
    font-size: 15px;
  }
  .legal :global(h2) {
    font-size: 24px;
    margin: 32px 0 12px;
  }
  .legal :global(p),
  .legal :global(li) {
    color: var(--tinta-2);
  }
  .legal :global(p) {
    margin-bottom: 12px;
  }
  .legal :global(ul) {
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0 0 12px;
  }
  .legal :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 16px;
    font-size: 15px;
  }
  .legal :global(th),
  .legal :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid var(--linea);
    vertical-align: top;
  }
</style>
