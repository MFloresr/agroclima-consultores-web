# Copia este archivo como .env y rellena los valores. Nunca subas .env al repositorio.
# Sin SUPABASE_*, en desarrollo el formulario solo registra la solicitud en la consola.

# Supabase (Project Settings → API). Proyecto en región UE.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Resend (dominio agroclimaconsultores.es verificado)
RESEND_API_KEY=
CONTACT_EMAIL_TO=jordi@agroclimaconsultores.es
CONTACT_EMAIL_FROM="AgroClima web <web@agroclimaconsultores.es>"

# Cloudflare Turnstile (opcional en desarrollo)
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Secreto del cron diario (Vercel lo envía como "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
